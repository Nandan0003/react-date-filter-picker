# Dependencies
node_modules/

# Build output (generated by `npm run build`; published to npm, not committed)
dist/

# Packed tarballs from `npm pack`
*.tgz

# Secrets and local config — never commit tokens
.env
.env.*
!.env.example
.npmrc

# Logs and caches
*.log
npm-debug.log*
.cache/
*.tsbuildinfo
coverage/

# Temporary files
tmp/
temp/
*.tmp

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

{
  "name": "react-date-filter-picker",
  "version": "1.0.1",
  "description": "A React date filter picker with On / Before / After / Between and quick ranges (Last 7 / Last 30 / Next 7 days). Zero dependencies, typed, themable with CSS variables.",
  "keywords": [
    "react",
    "date",
    "date-picker",
    "date-range",
    "date-filter",
    "calendar",
    "filter",
    "range-picker",
    "typescript"
  ],
  "license": "MIT",
  "author": "Nandan Kumar M <nandankumar3m@gmail.com> (https://github.com/Nandan0003)",
  "homepage": "https://github.com/Nandan0003/react-date-filter-picker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nandan0003/react-date-filter-picker.git"
  },
  "bugs": {
    "url": "https://github.com/Nandan0003/react-date-filter-picker/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack . --exclude-entrypoints styles.css",
    "prepublishOnly": "npm run typecheck && npm run build && npm run lint:package"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "publint": "^0.3.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
